gitlab_runner_config:
  concurrent: 4
  check_interval: 10
  session_server:
    session_timeout: 1800
  runners:
    - name: aws-aarch64-02
      output_limit: 32768
      url: https://gitlab.gnome.org
      token: "{{ gitlab_runner_gbm_token }}"
      executor: docker
      environment:
        - "FF_USE_GIT_NATIVE_CLONE=true"
      docker:
        tls_verify: false
        image: fedora:latest
        privileged: true
        disable_entrypoint_overwrite: false
        oom_kill_disable: false
        disable_cache: true
        volumes:
          - gbm_cache:/cache
          - casd_socket:/run/casd
        shm_size: 0
        security_opt:
          - "label=level:s0:c100,c100"
