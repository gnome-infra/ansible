gitlab_runner_config:
  concurrent: 4
  check_interval: 10
  shutdown_timeout: 0
  session_server:
    session_timeout: 1800
  runners:
    - name: redhat-runner-03
      url: https://gitlab.gnome.org
      id: 1182
      token: "{{ gitlab_runner_instance_wide_token }}"
      executor: docker
      environment:
        - "FF_USE_GIT_NATIVE_CLONE=true"
      docker:
        dns:
          - "169.254.1.1"
        dns_search: [""]
        tls_verify: false
        image: quay.io/fedora/fedora:latest
        privileged: false
        disable_entrypoint_overwrite: false
        oom_kill_disable: false
        disable_cache: true
        shm_size: 0
        devices:
          - /dev/kvm
          - /dev/udmabuf
        cap_add:
          - SYS_PTRACE
          - SYS_CHROOT
        security_opt:
          - "label=level:s0:c100,c100"
        tmpfs:
          "/tmp": "rw,nosuid,nodev,exec,mode=1777"
