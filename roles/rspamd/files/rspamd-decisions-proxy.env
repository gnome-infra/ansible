LISTEN_ADDR=127.0.0.1:8080
DECISIONS_ENDPOINT=https://api.fireworks.ai/inference/v1/systemone
DECISIONS_MODEL=accounts/fireworks/models/rune
POLICY_PATH=/etc/rspamd-decisions-proxy/policy.json
CACHE_PATH=/var/lib/rspamd-decisions-proxy/cache.db
CACHE_TTL=24h
CACHE_CLEANUP_INTERVAL=1h
UPSTREAM_TIMEOUT=6s
MAX_CONCURRENT_UPSTREAM=32
