global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s

rule_files:
  - rules/*.rules

{# Macro to extract tailscale IPv4 from either Linux or FreeBSD facts #}
{%- macro tailscale_ip(host) -%}
{%-   set facts = hostvars[host].ansible_facts | default({}) -%}
{%-   set ts = facts.get('tailscale0', facts.get('ansible_tailscale0', {})) -%}
{%-   set ipv4 = ts.get('ipv4', {}) -%}
{%-   if ipv4 is mapping -%}
{{      ipv4.get('address', '') -}}
{%-   elif ipv4 is iterable and ipv4 | length > 0 -%}
{{      ipv4[0].get('address', '') -}}
{%-   endif -%}
{%- endmacro -%}

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets:
          - 127.0.0.1:9090

  - job_name: 'node'
    static_configs:
{% set gitlab_runner_targets = [] %}
{% for host in groups['gitlab-runners'] + (groups['gitlab-runners-freebsd'] | default([])) %}
{%   set ts_ip = tailscale_ip(host) | trim %}
{%   if ts_ip %}
{%     set _ = gitlab_runner_targets.append(ts_ip ~ ':9100') %}
{%   endif %}
{% endfor %}
{% if gitlab_runner_targets %}
      - targets:
{% for target in gitlab_runner_targets %}
          - "{{ target }}"
{% endfor %}
        labels:
          role: gitlab-runner
{% endif %}

    relabel_configs:
{% for host in groups['gitlab-runners'] + (groups['gitlab-runners-freebsd'] | default([])) %}
{%   set ts_ip = tailscale_ip(host) | trim %}
{%   if ts_ip %}
      - source_labels: [ __address__ ]
        target_label: instance
        regex: "{{ ts_ip }}:9100"
        replacement: "{{ host }}"
{%   endif %}
{% endfor %}

{% set buildbox_casd_targets = [] %}
{% for host in groups['gitlab-runners'] %}
{%   set ts_ip = tailscale_ip(host) | trim %}
{%   if hostvars[host].gitlab_runner_buildbox_casd | default(false) and ts_ip %}
{%     set _ = buildbox_casd_targets.append(ts_ip ~ ':9102') %}
{%   endif %}
{% endfor %}
{% if buildbox_casd_targets %}

  - job_name: 'buildbox_casd'
    static_configs:
      - targets:
{% for target in buildbox_casd_targets %}
          - "{{ target }}"
{% endfor %}
    relabel_configs:
{% for host in groups['gitlab-runners'] %}
{%   set ts_ip = tailscale_ip(host) | trim %}
{%   if hostvars[host].gitlab_runner_buildbox_casd | default(false) and ts_ip %}
      - source_labels: [ __address__ ]
        target_label: instance
        regex: "{{ ts_ip }}:9102"
        replacement: "{{ host }}"
{%   endif %}
{% endfor %}
{% endif %}
